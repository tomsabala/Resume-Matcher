#!/usr/bin/env bash
#
# Fast pre-push gate for Resume-Matcher. Seconds, not minutes.
#
# Runs BEFORE every `git push` and BLOCKS the push if anything is red:
#   1. frontend locale parity  (pure-Python; guards the i18n build break)
#   2. frontend typecheck      (tsc --noEmit — catches test fixtures that
#                               `next build` never sees)
#
# The test suites are NOT here. They used to be, and the backend suite grew to
# 1543 tests: every push cost 12-15 minutes of the developer's own machine,
# serially, blocking the terminal, and was paid again for every one-line fixup.
# They now run on a runner — see .github/workflows/tests.yml, which triggers on
# pushes to main/dev and deliberately NOT on `pull_request`, so the high volume
# of external contributor PRs still costs nothing.
#
# What stays here earns its place by being fast enough to be free, and by
# catching things whose blast radius is worse than one red commit on main.
#
# Activate once per clone:   git config core.hooksPath .githooks
# Bypass intentionally:      git push --no-verify     (e.g. docs-only / WIP branch)
# Disable entirely:          git config --unset core.hooksPath
#
# Notes:
#  - Both checks always run so you see ALL failures, not just the first.
#  - The typecheck runs only when Node is on PATH (git hooks may run without
#    nvm's node). A full `next build` is still NOT run here.

set -uo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
status=0

printf '\n── pre-push gate ────────────────────────────────────────\n'

# 1) Frontend locale parity (no Node required) -----------------------------
#    Sub-second, and it guards the exact i18n mismatch that once broke
#    `next build` and only surfaced post-merge in the Docker job.
if command -v python3 >/dev/null 2>&1; then
  echo "▶ frontend : locale parity (messages/*.json vs en.json)"
  if ! python3 "$REPO_ROOT/scripts/check_locale_parity.py"; then
    status=1
  fi
else
  echo "  ⚠ python3 not found — skipping locale parity check" >&2
fi

# 2) Frontend typecheck (tsc --noEmit) — ~15s, and `next build` only typechecks
#    its own module graph, so a broken test fixture goes unnoticed by every other
#    gate. tsconfig includes tests, so this is the only thing that catches them.
TSC="$REPO_ROOT/apps/frontend/node_modules/.bin/tsc"
if command -v node >/dev/null 2>&1 && [ -x "$TSC" ]; then
  echo "▶ frontend : tsc --noEmit"
  if ! ( cd "$REPO_ROOT/apps/frontend" && "$TSC" --noEmit ); then
    echo "  ✗ frontend typecheck failed" >&2
    status=1
  fi
else
  echo "  ⚠ node or tsc not available — skipping frontend typecheck" >&2
fi

printf '─────────────────────────────────────────────────────────\n'
if [ "$status" -ne 0 ]; then
  echo "✗ pre-push gate FAILED — push aborted. Fix the above, or bypass with: git push --no-verify" >&2
  exit 1
fi
echo "✓ pre-push gate passed — pushing."
exit 0
