<# Compact: same structure, tighter margins and no section rules — for a
     dense two-page history that must fit one page. #>
<< layout.documentclass >>

\usepackage{url}
\usepackage{parskip}
\RequirePackage{color}
\RequirePackage{graphicx}
\usepackage[usenames,dvipsnames]{xcolor}
\usepackage[<< layout.geometry >>]{geometry}
\usepackage{tabularx}
\usepackage{enumitem}
\usepackage{supertabular}
\usepackage{titlesec}
\usepackage{multicol}
\usepackage{multirow}
\usepackage{fontawesome5}
\usepackage{amssymb}
\usepackage{textcomp}

\newcolumntype{C}{>{\centering\arraybackslash}X}
\newlength{\fullcollw}
\setlength{\fullcollw}{0.47\textwidth}

\titleformat{\section}{<< layout.section_size >>\bfseries\scshape\raggedright}{}{0em}{}
\titlespacing{\section}{0pt}{<< layout.section_before >>}{<< layout.section_after >>}
\linespread{<< layout.linespread >>}
\setlength{\parskip}{2pt}

<# Same rhythm knobs as classic, tighter: compact sets `\parskip` to 2pt, so
     the identical `\vspace` yields a larger gap. The lengths come from
     `app/latex/layout.py`; at the neutral level `-9pt` measures 11.1pt
     against classic's 13.8pt, keeping compact the denser template. #>
\newcommand{\resumeEntryGap}{\vspace{<< layout.entry_gap >>}}
\newcommand{\resumeSectionEnd}{\vspace{<< layout.section_end >>}}
\newcommand{\resumeBlockEnd}{\vspace{<< layout.block_end >>}}
\newcommand{\resumeItemSep}{<< layout.item_sep >>}

\usepackage[unicode, draft=false]{hyperref}
\definecolor{linkcolour}{rgb}{0,0.2,0.6}
\hypersetup{colorlinks,breaklinks,urlcolor=linkcolour,linkcolor=linkcolour,pdftitle={<< (header.name or 'Resume') | tex >>}}

\newenvironment{jobshort}[2]
    {
    \begin{tabularx}{\linewidth}{@{}l X r@{}}
    \textbf{#1} & \hfill & #2 \\[1pt]
    \end{tabularx}
    }
    {
    }

\newenvironment{joblong}[2]
    {
    \begin{tabularx}{\linewidth}{@{}l X r@{}}
    \textbf{#1} & \hfill & #2 \\[1pt]
    \end{tabularx}
    \begin{minipage}[t]{\linewidth}
    \begin{itemize}[nosep,after=\strut, leftmargin=1em, itemsep=\resumeItemSep,label=\textbullet]
    }
    {
    \end{itemize}
    \end{minipage}
    }

